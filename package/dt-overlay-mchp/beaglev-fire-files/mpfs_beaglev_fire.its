 * Adapted for BeagleV-Fire by buildroot-external-microchip
 *
 */

/dts-v1/;

/ {
	description = "U-Boot fitImage for the MPFS BeagleV-Fire";
	#address-cells = <2>;

		images {
			kernel {
				description = "Linux kernel";
				data = /incbin/("./Image.gz");
				type = "kernel";
				arch = "riscv";
				os = "linux";
				compression = "gzip";
				load = <0x80200000>;
				entry = <0x80200000>;
				hash-1 {
					algo = "sha256";
				};
			};
			fdt-beagle-beaglev-fire.dtb {
				description = "Flattened Device Tree blob";
				data = /incbin/("./dts/microchip/mpfs-beaglev-fire.dtb");
				type = "flat_dt";
				arch = "riscv";
				compression = "none";
				load = <0x8a000000>;
				hash-1 {
					algo = "sha256";
				};
			};
			fdt-mpfs-beaglev-fire-amp.dtbo {
				description = "Device Tree blob for AMP";
				data = /incbin/("./mpfs_beaglev_fire/mpfs_beaglev_fire_amp.dtbo");
				type = "flat_dt";
				arch = "riscv";
				compression = "none";
				load = <0x8a0b0000>;
				hash-1 {
					algo = "sha256";
				};
			};
		};

		configurations {
			default = "conf-beagle,beaglev-fire";
			conf-beagle,beaglev-fire {
				description = "1 Linux kernel, FDT blob";
				kernel = "kernel";
				fdt = "fdt-beagle-beaglev-fire.dtb";
			};

			conf-beagle,mpfs-beaglev-fire-amp {
				description = "FDT overlay blob for AMP";
				fdt = "fdt-mpfs-beaglev-fire-amp.dtbo";
			};

			conf-beagle,fdt-beagle-beaglev-fire.dtb {
				description = "Base FDT blob for MPFS BeagleV-Fire board";
				fdt = "fdt-beagle-beaglev-fire.dtb";
			};
		};
};