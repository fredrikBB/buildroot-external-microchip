# BeagleV-Fire Makefile additions
# This file contains the Makefile modifications needed to add BeagleV-Fire support

# Add to BDIR line (insert mpfs_beaglev_fire after mpfs_icicle_amp)
BDIR_ADDITION=mpfs_beaglev_fire

# Add DTBO objects variable (insert after MPFS_ICICLE_AMP_DTBO_OBJECTS)
DTBO_OBJECTS_ADDITION=MPFS_BEAGLEV_FIRE_DTBO_OBJECTS:= $(patsubst %.dtso,%.dtbo,$(wildcard mpfs_beaglev_fire/*.dtso))

# Add dtbos target (insert after mpfs_icicle_amp_dtbos)
DTBOS_TARGET_ADDITION=mpfs_beaglev_fire_dtbos: $(MPFS_BEAGLEV_FIRE_DTBO_OBJECTS)